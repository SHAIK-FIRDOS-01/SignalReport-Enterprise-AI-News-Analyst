# Backend Environment Variables
SECRET_KEY=django-insecure-signalreport-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL 17 + pgvector)
DB_NAME=signalreport
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Cache & Celery Broker
REDIS_URL=redis://127.0.0.1:6379/0

# Inter-Service Authentication
INTERNAL_SERVICE_KEY=signalreport_enterprise_internal_shared_secret_2026
MICROSERVICE_URL=http://127.0.0.1:8001

# JWT Authentication
JWT_SECRET_KEY=signalreport_jwt_secret_key_production_grade_argon2id
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Third-Party Integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
