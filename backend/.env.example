# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signalreport

# Security & Cryptographic Tokens
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# GNews Ingestion Configuration & Quota Budgeting
GNEWS_API_KEY=your_gnews_api_key_here
GNEWS_BASE_URL=https://gnews.io/api/v4
GNEWS_MAX_DAILY_CALLS=80

# Groq LLM Intelligence Configuration & Rate Banning
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_REQUESTS_BEFORE_BAN=3
LLM_BAN_DURATION_HOURS=4
